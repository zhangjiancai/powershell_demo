# AIPredictor.psm1
# ========================================================================
# 智能命令预测插件：基于阿里云百炼 Qwen3-Max 的 AI 预测器
# 功能：
#   - 自动感知用户输入（由 PSReadLine 驱动）
#   - 注入环境上下文（路径、模块、OS 等）
#   - 防抖 + 缓存 + 安全过滤
#   - 记录成功预测用于分析
# 作者：你
# 日期：2026-01-22
# ========================================================================

using namespace System.Collections.Generic
using namespace System.Management.Automation
using namespace System.IO

class AIPredictor : ICommandPredictor {
    # 插件唯一标识
    [Guid]$Id = [Guid]::NewGuid()
    # 插件名称
    [string]$Name = "AIPredictor"
    # 插件描述
    [string]$Description = "AI command prediction with context awareness and logging"

    # 静态配置（从 config.json 加载）
    static [hashtable] $Config = $null
    # 预测结果缓存（避免重复请求）
    static [hashtable] $Cache = @{}
    # 上次请求时间（用于防抖）
    static [DateTime] $LastRequestTime = [DateTime]::MinValue
    # 日志文件路径
    static [string] $LogPath = ""

    # ------------------------------------------------------------------------
    # 初始化配置：加载 config.json 或使用默认值
    # ------------------------------------------------------------------------
    static [void] Initialize() {
        if ($null -eq [AIPredictor]::Config) {
            # 获取当前模块路径
            $modulePath = [System.IO.Path]::GetDirectoryName($MyInvocation.MyCommand.Path)
            $configPath = Join-Path $modulePath "config.json"
            [AIPredictor]::$LogPath = Join-Path $modulePath "ai_predictions.log"

            if (Test-Path $configPath) {
                [AIPredictor]::Config = Get-Content $configPath | ConvertFrom-Json -AsHashtable
            } else {
                Write-Warning "未找到配置文件: $configPath，使用默认设置"
                [AIPredictor]::Config = @{
                    Provider = "Aliyun"
                    Model = "qwen3-max"
                    ApiKey = $env:LLM_API_KEY
                    TimeoutSeconds = 3
                    MinInputLength = 5
                    DebounceMs = 800
                }
            }
        }
    }

    # ------------------------------------------------------------------------
    # 生成环境上下文字符串，注入到 LLM 提示词中
    # 目的：让 AI 了解用户当前环境，生成更精准命令
    # ------------------------------------------------------------------------
    static [string] GetEnvironmentContext() {
        return @"
[Environment Context]
- OS: $($PSVersionTable.OS)
- PowerShell Version: $($PSVersionTable.PSVersion)
- Current Directory: $(Get-Location)
- User: $([Environment]::UserName)
- Host: $([Environment]::MachineName)
- Loaded Modules: $((Get-Module | ForEach-Object { $_.Name }) -join ', ')
- Environment Variables (selected): 
  USERPROFILE = $env:USERPROFILE
  TEMP = $env:TEMP
"@
    }

    # ------------------------------------------------------------------------
    # PSReadLine 调用此方法获取预测建议
    # 参数：
    #   $client  - 预测客户端（通常不用）
    #   $context - 当前输入上下文（含用户输入文本）
    # 返回：
    #   CompletionResult[] - 预测结果列表（通常只返回一个）
    # ------------------------------------------------------------------------
    [IEnumerable[CompletionResult]] GetSuggestion([PredictionClient] $client, [PredictionContext] $context) {
        [AIPredictor]::Initialize()

        $input = $context.Input.Trim()
        $minLen = [AIPredictor]::Config.MinInputLength
        
        # 过滤：输入太短 或 看起来像标准 cmdlet（如 Get-Process）
        if ($input.Length -lt $minLen -or $input -match '^[a-zA-Z][a-zA-Z0-9\-]*$') {
            return @()
        }

        # 缓存命中：直接返回历史结果
        if ([AIPredictor]::Cache.ContainsKey($input)) {
            return [CompletionResult]::new([AIPredictor]::Cache[$input])
        }

        # 防抖：避免频繁调用 API（至少间隔 DebounceMs 毫秒）
        $now = [DateTime]::Now
        if (($now - [AIPredictor]::LastRequestTime).TotalMilliseconds -lt [AIPredictor]::Config.DebounceMs) {
            return @()
        }

        # 获取 API Key（优先 config.json，其次环境变量）
        $apiKey = [AIPredictor]::Config.ApiKey
        if (-not $apiKey) { $apiKey = $env:LLM_API_KEY }
        if (-not $apiKey) { return @() }

        # 调用 LLM 获取预测
        $suggestion = [AIPredictor]::GetCommandFromLLM($input, $apiKey)
        [AIPredictor]::LastRequestTime = [DateTime]::Now

        if ($suggestion -and $suggestion -ne $input) {
            # 缓存结果（最多 50 条，防止内存泄漏）
            [AIPredictor]::Cache[$input] = $suggestion
            if ([AIPredictor]::Cache.Count -gt 50) { [AIPredictor]::Cache = @{} }
            return [CompletionResult]::new($suggestion)
        }

        return @()
    }

    # ------------------------------------------------------------------------
    # 当用户接受预测建议时调用（例如按 → 键）
    # 用途：记录成功预测，用于后续分析或优化
    # 注意：此方法不应抛出异常，否则会破坏终端体验
    # ------------------------------------------------------------------------
    [void] OnSuggestionAccepted([PredictionClient] $client, [PredictionContext] $context, [CompletionResult] $result) {
        try {
            # 构造日志条目
            $logEntry = [PSCustomObject]@{
                Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
                Input     = $context.Input
                Prediction = $result.ToolTip
                User      = $env:USERNAME
                Path      = (Get-Location).Path
            }
            # 追加到 CSV 日志
            $logEntry | Export-Csv -Path [AIPredictor]::$LogPath -Append -NoTypeInformation -Encoding UTF8
        }
        catch {
                if ($global:DebugAIPredictor) {
                  Write-Debug "AI Prediction Error: $_"
                  }
            # ⚠️ 为什么这里不写错误处理？
            # 答：日志失败不应影响主流程。终端体验优先。
            # 如果写 Write-Error，会导致命令行卡顿或报错。
            # 所以静默失败是最佳实践。
        }
    }

    # ------------------------------------------------------------------------
    # 调用阿里云百炼 API 获取 PowerShell 命令
    # 参数：
    #   $prompt - 用户输入
    #   $apiKey - API 密钥
    # 返回：
    #   string - 生成的 PowerShell 命令（或空字符串）
    # ------------------------------------------------------------------------
    static [string] GetCommandFromLLM([string]$prompt, [string]$apiKey) {
        $config = [AIPredictor]::Config
        $timeout = $config.TimeoutSeconds
        $context = [AIPredictor]::GetEnvironmentContext()

        $uri = "https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation"
        $headers = @{ Authorization = "Bearer $apiKey" }
        $body = @{
            input = @{
                messages = @(
                    @{
                        role = "user"
                        content = @"
You are an expert PowerShell assistant. Generate a single line of valid, safe, and efficient PowerShell code based on the user's request and environment context.

$context

Rules:
- Output ONLY the PowerShell command. No explanation, no markdown, no quotes.
- Do NOT use dangerous commands (e.g., Remove-Item -Recurse, Invoke-Expression) unless explicitly requested.
- Prefer modern, approved cmdlets.
- Respect the user's environment (e.g., if in Azure project, use Az modules).

User request: $prompt
"@
                    }
                )
            }
            parameters = @{
                model = $config.Model
                temperature = 0.2
                max_tokens = 150
            }
        } | ConvertTo-Json -Depth 5

        try {
            $response = Invoke-RestMethod -Uri $uri -Method Post -Headers $headers -ContentType "application/json" -Body $body -TimeoutSec $timeout
            return $response.output.text.Trim()
        }
        catch {
                  if ($global:DebugAIPredictor) {
                  Write-Debug "AI Prediction Error: $_"
                  }
            # ⚠️ 为什么这里不写错误处理？
            # 答：预测失败是正常现象（网络超时、配额用尽等）。
            # 如果弹出错误，会打断用户输入流，体验极差。
            # 更好的做法：静默失败，让用户继续输入。
            # （高级用户可在调试模式下启用 Write-Debug）
            return ""
        }
    }
}

# ------------------------------------------------------------------------
# 导出函数：注册预测器
# ------------------------------------------------------------------------
function Register-AIPredictor {
    [AIPredictor]::Initialize()
    Register-CommandPredictor -Implementation ([AIPredictor]::new())
}


