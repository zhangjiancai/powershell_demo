{
  "Provider": "DeepSeek",
  "Model": "deepseek-chat",
  "ApiKey": "sk-在这里填你的 API Key（也可用环境变量 LLM_API_KEY / DEEPSEEK_API_KEY）",
  "Endpoint": "https://api.deepseek.com/chat/completions",
  "TimeoutSeconds": 8,
  "MinInputLength": 4,
  "DebounceMs": 800,
  "MaxTokens": 200,
  "Temperature": 0.2,
  "MaxCacheEntries": 200,
  "MaxSuggestionLength": 500,
  "Hotkey": "Alt+P",
  "EnableTabCompletion": true,
  "EnableLog": true,
  "LogPath": "ai_predictions.log",
  "SystemPrompt": ""
}
