# ===== 不入库（体积大 / 运行时生成 / 含敏感信息）=====

# 模块目录（约 900 MB）—— AIPredictor 是我们自己的代码，单独放行
Modules/*
!Modules/AIPredictor/

# AIPredictor：config.json 含明文 API Key，编译产物与日志也不入库
Modules/AIPredictor/config.json
Modules/AIPredictor/bin/
Modules/AIPredictor/*.log

# ---- 敏感文件（防止误提交；用精确规则，避免误伤正常文件）----
config.json
*.key
*.pem
*.pfx
*.p12
*.ppk
id_rsa*
.env
.env.*
credentials.json
secrets.json
*credentials*.json
*secrets*.json

# 更全面的检查：Scripts/Test-NoSecrets.ps1（已装入 .git/hooks/pre-commit）

# Nerd Font 字体（约 280 MB）
Meslo/
Meslo_LG_Nerd_Font/

# Az.Tools.Predictor 运行时缓存
AzPredictor/

# 命令历史（可能包含敏感命令）
PSReadLine/

# 杂项
*.log
